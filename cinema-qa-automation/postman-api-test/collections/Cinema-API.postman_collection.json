        {
          "name": "TC-API-04 Login valid",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// NOTE: If the backend requires email verification before allowing login,",
                  "// this test will fail with 401/403 even though registration succeeded.",
                  "// In that case, manually verify the email in DB or disable email verification",
                  "// for the test environment, then re-run.",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response time < 2000ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "pm.test('Response contains token', () => {",
                  "  const body = pm.response.json();",
                  "  // Handle both { token, user } and { data: { token, user } } shapes",
                  "  const token = (body.data && body.data.token) ? body.data.token : body.token;",
                  "  pm.expect(token).to.be.a('string').and.not.empty;",
                  "  pm.environment.set('token', token);",
                  "  // Save userId from whichever shape the API returns",
                  "  const user = (body.data && body.data.user) ? body.data.user : body.user;",
                  "  if (user && user.id) {",
                  "    pm.environment.set('userId', user.id);",
                  "  }",
                  "});"
                ]
              }
            }
          ],
