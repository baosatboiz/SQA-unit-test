        {
          "name": "TC-API-10 Showtime detail with seats",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response time < 2000ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "pm.test('Response has seats array', () => {",
                  "  const body = pm.response.json();",
                  "  // Seats may be at body.seats or body.data.seats",
                  "  let showtime = body.data || body;",
                  "  let seats = showtime.seats;",
                  "  pm.expect(seats).to.be.an('array');",
                  "  pm.expect(seats.length).to.be.above(0);",
                  "  // Save the first AVAILABLE seat id for booking",
                  "  const availableSeat = seats.find(s => {",
                  "    const status = (s.status || s.seat_status || '').toUpperCase();",
                  "    return status === 'AVAILABLE' || status === '' || status === undefined;",
                  "  });",
                  "  if (availableSeat) {",
                  "    pm.environment.set('seatId', availableSeat.id);",
                  "  } else {",
                  "    // Fallback: use first seat even if status unknown",
                  "    pm.environment.set('seatId', seats[0].id);",
                  "    console.warn('No AVAILABLE seat found; falling back to seats[0].id');",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
