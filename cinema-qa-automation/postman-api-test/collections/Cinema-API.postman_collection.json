              "host": ["{{baseUrl}}{{apiPath}}"],
              "path": ["payments"]
            }
          }
        },
        {
          "name": "TC-API-17 Get payments by booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
