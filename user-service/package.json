{
  "name": "user-service",
  "version": "1.0.0",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:services": "vitest run --coverage",
    "coverage:visual": "node ../scripts/generate-service-method-coverage-report.cjs --service-dir .",
    "test:coverage:visual": "npm run test:coverage:services && npm run coverage:visual",
    "test:verbose": "vitest run --reporter=verbose",
    "test:coverage:verbose": "vitest run --coverage --reporter=verbose"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.7.15",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "joi": "^17.9.2",
    "pg": "^8.11.1",
    "pg-hstore": "^2.3.4",
    "redis": "^5.9.0",
    "sequelize": "^6.32.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.12",
    "@types/express": "^5.0.3",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "rimraf": "^5.0.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.5"
  }
}
